<?xml version="1.0" encoding="UTF-8"?>
<!-- Home custom. Build: src/tv-app (ADR-0003). Deploy: scripts/tv-app.sh install src/tv-app/dist -->
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets"
        id="http://github.com/otaviano/samsung-tv-platform/home" version="0.5.0" viewmodes="maximized">
  <tizen:application id="OtvHome001.home" package="OtvHome001" required_version="5.5"/>
  <tizen:profile name="tv-samsung"/>
  <content src="index.html"/>
  <!-- background-support: processo segue vivo atrás de outros apps e congela no standby;
       base do retorno no power-on e ao fim do app aberto (src/lifecycle, E8/E9). -->
  <name>Home</name>
  <feature name="http://tizen.org/feature/screen.size.all"/>
  <!-- internet: catálogo/control plane no futuro; em dev, o report-sink na estação -->
  <access origin="*" subdomains="true"/>
  <tizen:privilege name="http://tizen.org/privilege/internet"/>
  <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
  <tizen:privilege name="http://tizen.org/privilege/application.launch"/>
  <!-- webapis.network: status/SSID na barra superior (E10) -->
  <tizen:privilege name="http://developer.samsung.com/privilege/network.public"/>
  <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="enable"
                 encryption="disable" install-location="auto" hwkey-event="enable"/>
</widget>
