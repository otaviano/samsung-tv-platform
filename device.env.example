# Copie para `device.env` (não versionado) e preencha com os valores do SEU ambiente.
#   cp device.env.example device.env
#
# Os documentos deste repo usam os placeholders <TV_IP>, <HOST_IP>, <TV_MODEL> etc.
# em lugar de valores reais: topologia de rede e modelo+firmware são tratados como
# dados sensíveis. Ver docs/security.md.

# Rede
TV_IP=192.0.2.10              # IP da TV na LAN
HOST_IP=192.0.2.20            # IP da estação de desenvolvimento (vai no Host PC IP da TV)
GATEWAY_IP=192.0.2.1          # roteador / resolver DNS atual
LAN_SUBNET=192.0.2.0/24
WIFI_IFACE=wlan0              # interface da estação (ex.: `ip -4 -br addr show`)

# Device — obtidos de `scripts/discover-tv.sh`
TV_MODEL=XXXXXXXXXXXXX        # device.modelName
TV_FIRMWARE=T-XXXXXXXX-XXXX.X # string exibida no menu da TV
TV_MODEL_GROUP=XX_XXXXX_XXX_XXXXX  # device.model (grupo interno)
